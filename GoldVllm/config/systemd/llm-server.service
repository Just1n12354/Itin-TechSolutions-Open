# Beispiel-Unit fuer GoldVllm. Anpassen: User, Pfad zu run-goldvllm.sh, VOCAB, KEYFILE.
# Original von gx10 zum Vergleich: llm-server.service.gx10-original (startet ueber switch-model.sh aus blazux-Repo).
[Unit]
Description=GoldVllm - Qwen3.8-Flash-Next-NVFP4 auf 127.0.0.1:8000
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=DEIN_NUTZER
Environment=VOCAB=/opt/gx10/draftvocab/draft_vocab_de_65536.npy
Environment=KEYFILE=/home/DEIN_NUTZER/.config/vllm.key
# auf den NVIDIA-Treiber warten (nach dem Boot nicht sofort da)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do nvidia-smi -L >/dev/null 2>&1 && exit 0; sleep 2; done; exit 1'
ExecStart=/opt/goldvllm/config/run-goldvllm.sh
# erst "fertig", wenn die API antwortet (bis 40 min)
ExecStartPost=/bin/sh -c 'for i in $(seq 1 240); do [ "$(curl -s -o /dev/null -w %%{http_code} -m 5 http://127.0.0.1:8000/v1/models)" = 401 ] && exit 0; sleep 10; done; exit 1'
ExecStop=/usr/bin/docker stop -t 60 qwen38-flash
TimeoutStartSec=2700
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
